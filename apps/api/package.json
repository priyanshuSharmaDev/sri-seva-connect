    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "pg": "^8.17.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
