{
  "expo": {
    "name": "Sri Seva Connect",
    "slug": "sri-seva-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-spiritual.png",
    "scheme": "sriseva",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon-spiritual.png"
    },
    "android": {
      "package": "com.sriseva.connect",
      "adaptiveIcon": {
        "backgroundColor": "#0B2341",
        "foregroundImage": "./assets/images/app-icon-spiritual.png",
        "monochromeImage": "./assets/images/gaudiya-tilak.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-spiritual.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2341",
          "image": "./assets/images/gaudiya-tilak.png",
          "imageWidth": 92
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
