{
  "expo": {
    "name": "Sri Seva Connect",
    "slug": "sri-seva-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-spiritual.png",
    "scheme": "sriseva",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon-spiritual.png"
    },
    "android": {
      "package": "com.sriseva.connect",
      "adaptiveIcon": {
        "backgroundColor": "#0B2341",
        "foregroundImage": "./assets/images/app-icon-spiritual.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-spiritual.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2341",
          "image": "./assets/images/gaudiya-tilak.png",
          "imageWidth": 92
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53492d1c-0d59-491d-a7c1-24cc6af17007"
      }
    },
    "owner": "priyanshusharmadevs-team"
  }
}
